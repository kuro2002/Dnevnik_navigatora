# Пароль для входа на сайт (обязательно поменять)
NAV_PASSWORD=change-me
# Секрет для подписи сессий (любая длинная случайная строка)
NAV_SECRET_KEY=change-me-to-random-string
# Где лежат база и загруженные аудио
NAV_DATA_DIR=./data
# Токен для программы на Windows (транскрибация)
NAV_WORKER_TOKEN=change-me-worker-token

# --- Разборщик: Ollama на компьютере психолога (адрес в Tailscale) ---
NAV_OLLAMA_URL=http://desktop-pc:11434
NAV_OLLAMA_MODEL=qwen3:14b
NAV_OLLAMA_NUM_CTX=16384

# --- Разборщик: YandexGPT ---
NAV_YANDEX_API_KEY=
NAV_YANDEX_FOLDER_ID=
NAV_YANDEX_MODEL=yandexgpt/latest

# --- Транскрибация: audiocpp_server на компьютере психолога (адрес в Tailscale) ---
# Запуск на Windows: audiocpp_server --config server.json  (в server.json слушать 0.0.0.0:8080)
NAV_ASR_URL=http://desktop-pc:8080
NAV_ASR_MODEL=
NAV_ASR_LANGUAGE=ru
NAV_ASR_FILE_FIELD=file
# Как часто повторять попытку, если компьютер был выключен
NAV_ASR_RETRY_MINUTES=10

# Сколько символов транскрипта отдавать модели за раз (длинные сессии режутся на части)
NAV_CHUNK_CHARS=24000
